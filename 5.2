CREATE VIEW student_info AS
SELECT Student_Name, Email, Dept_ID
FROM Student;

CREATE VIEW student_above20 AS
SELECT *
FROM Student
WHERE Age > 20;

CREATE VIEW course_info AS
SELECT Course_Name, Credits
FROM Course;

