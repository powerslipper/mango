SELECT Department, COUNT(*)
FROM Student_Result
GROUP BY Department;

SELECT subject, AVG(Marks)
FROM Student_Result
GROUP BY subject;

SELECT Department, AVG(Marks)
FROM Student_Result
GROUP BY Department
HAVING AVG(Marks) > 80;

SELECT subject, COUNT(*)
FROM Student_Result
GROUP BY subject
HAVING COUNT(*) > 2;
